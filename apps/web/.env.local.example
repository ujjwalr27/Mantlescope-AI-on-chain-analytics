# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key_here

# Etherscan v2 (covers Mantle Mainnet chainId=5000 and Sepolia chainId=5003)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Upstash QStash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key_here

# Oracle wallet (server-side only, NEVER expose to client)
ORACLE_PRIVATE_KEY=0x_your_oracle_private_key_here

# Deployed contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x_deployed_mantlescope_insights_address

# Chain for contract interactions (5003 = Mantle Sepolia testnet)
NEXT_PUBLIC_CHAIN_ID=5003

# Chain for DATA fetching — use mainnet for rich real data
DATA_CHAIN_ID=5000

# DEX data is fetched directly from Agni and Merchant Moe public APIs — no subgraph keys needed
